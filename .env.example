# Copy to .env for local overrides. Host ports avoid AgriVision (4280-81, 5000, 5280-81, 6379, 8080, 8100-01) and Nexora (5173, 8000). DEMO values only: never put real secrets or real data here.
POSTGRES_USER=aahar
POSTGRES_PASSWORD=change-me-demo
POSTGRES_DB=aaharos
DB_PORT=5442
API_PORT=8180
WEB_PORT=5180
AAHAR_ENV=dev
# Password for the API's non-owner database role aahar_app (created by the first migration; ADR-0006)
AAHAR_APP_DB_PASSWORD=change-me-demo

# MP03: signs access tokens. Set a long random value; the default is refused when AAHAR_ENV is not dev/test.
AAHAR_AUTH_SECRET=dev-only-DEMO-secret-change-me-0123456789abcdef

# MP03: DEMO login passwords per role, used by `make seed-demo` (see README "Test logins")
DEMO_PASSWORD_SALESMAN=change-me-demo
DEMO_PASSWORD_ADMIN=change-me-demo
DEMO_PASSWORD_PRODUCTION=change-me-demo
DEMO_PASSWORD_OWNER=change-me-demo
DEMO_PASSWORD_AUDITOR=change-me-demo

# MP15: Judge Mode may reset the BENCHMARK tenant only when this is true
JUDGE_MODE_ENABLED=false
